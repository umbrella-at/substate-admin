root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,vue,json,yml,yaml,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# `caddy fmt` emits tabs and provision.sh validates the file it ships;
# the config follows the formatter, not the other way round.
[Caddyfile]
indent_style = tab
