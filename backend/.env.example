# Local development configuration. Copy to backend/.env and fill in; .env is never committed.
#
# In production none of this comes from a file in the tree: systemd reads
# /etc/substate-admin/api.env, which provisioning writes once and CI never touches. This file
# exists so that a checkout can be run, and so that the set of keys is written down somewhere
# other than app/config.py.
#
# The first three have no defaults and no fallbacks. The application refuses to start without
# them, which is the point of them: a host serving with a guessable signing key must fail its
# smoke check instead.
#
# Every key is listed here, empty. Delete the lines you have nothing to say about rather than
# leaving them blank: an empty value is still a value, and `COOKIE_SECURE=` is not a boolean.

# postgresql+psycopg://user:password@host:port/database — the driver prefix is checked at
# startup, because `postgresql://` silently selects psycopg2 and fails much later with a message
# about DBAPIs. With docker-compose.yml at the repository root:
#   postgresql+psycopg://postgres:postgres@127.0.0.1:5432/substate_admin
DATABASE_URL=

# Signs the 15-minute access tokens. `openssl rand -hex 32`. Changing it logs everyone out.
JWT_SECRET=

# The HMAC key that turns a client IP into the ip_hash used by rate limiting and the logs.
# `openssl rand -hex 32`. Changing it invalidates every hash already recorded.
IP_HASH_PEPPER=

# production | development | test. Anything but "production" also publishes /api/docs and
# /api/openapi.json. Unset means production, so that a forgotten variable cannot be the thing
# that puts the schema on the internet.
APP_ENV=

# Safari refuses a Secure cookie over http://localhost and says nothing about it, so a local run
# with this left at its default logs in and immediately cannot refresh. Set it to false locally
# and nowhere else.
COOKIE_SECURE=

# The commit GET /api/health reports. Left empty the application reads the RELEASE file the
# deploy writes into the release directory, and reports "unknown" when there is neither.
APP_COMMIT=
