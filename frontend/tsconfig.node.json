{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Every file that configures a tool, and the end-to-end specs, which run in Node rather than in
     the browser. A config file left out of both projects is a file `typecheck` never opens — and
     the failure it hides is a build that only breaks in CI. */
  "include": [
    "vite.config.ts",
    "eslint.config.ts",
    "playwright.config.ts",
    "playwright.capture.config.ts",
    "e2e/**/*.ts",
    "capture/**/*.ts"
  ]
}
